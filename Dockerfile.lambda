# Use AWS-provided Python 3.11 base image for Lambda (x86_64)
FROM public.ecr.aws/lambda/python:3.11

# Respect nfl_stadiums resource location
ENV NFL_STADIUM_RESOURCES=/tmp/nfl_stadium_resources

# All configuration values have defaults in constants.py
# Optionally override via Lambda environment variables:
# ENV LOG_LEVEL=INFO
# ENV VERBOSE_ADJUSTMENTS=false
# ENV ENABLE_INJURY_ADJUSTMENTS=false
# ENV ENABLE_WEATHER_ADJUSTMENTS=false
# ENV ENABLE_UPSETS_AGENT=true

# Set the working directory (Lambda expects everything under /var/task)
WORKDIR /var/task

# Install dependencies
COPY nfl_predictor/requirements.txt .
RUN pip3 install --upgrade pip && pip3 install --no-cache-dir -r requirements.txt

# Copy all code including data, utils, and handler
COPY nfl_predictor /var/task/nfl_predictor

# Lambda entry point
CMD ["nfl_predictor.lambda_handler.handler"]
