# Multi-stage build: dependencies layer
FROM public.ecr.aws/lambda/python:3.11 as builder

WORKDIR ${LAMBDA_TASK_ROOT}

# Copy project files
COPY pyproject.toml .
COPY README.md .
COPY LICENSE .

# Install dependencies to layer
RUN pip install --upgrade pip && \
    pip install --target "${LAMBDA_TASK_ROOT}" -e .

# Final Lambda image
FROM public.ecr.aws/lambda/python:3.11

# Configuration values have defaults in constants.py
WORKDIR ${LAMBDA_TASK_ROOT}

# Copy dependencies from builder
COPY --from=builder ${LAMBDA_TASK_ROOT} ${LAMBDA_TASK_ROOT}

# Copy application code
COPY nfl_predictor ${LAMBDA_TASK_ROOT}/nfl_predictor

# Lambda entry point
CMD ["nfl_predictor.lambda_handler.handler"]
