# Multi-stage build: dependencies layer
FROM public.ecr.aws/lambda/python:3.12 as builder

WORKDIR /build

# Copy project files
COPY pyproject.toml README.md LICENSE ./
COPY nfl_predictor /build/nfl_predictor

# Install package (with bundled data files) and dependencies into the Lambda task root
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir --target "${LAMBDA_TASK_ROOT}" .

# Final Lambda image
FROM public.ecr.aws/lambda/python:3.12

WORKDIR ${LAMBDA_TASK_ROOT}

# Copy installed package + dependencies from builder
COPY --from=builder ${LAMBDA_TASK_ROOT} ${LAMBDA_TASK_ROOT}

# Lambda entry point
CMD ["nfl_predictor.lambda_handler.handler"]
