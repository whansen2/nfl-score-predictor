# NFL Score Predictor Environment Variables Template

# OpenAI API key for Blitz (required)
OPENAI_API_KEY=your_openai_api_key_here

# All other configuration values are defined in nfl_predictor/utils/constants.py
# You can optionally override them here if needed:

# Logging
# LOG_LEVEL=INFO

# Feature flags (true/false)
# DEFAULT_VERBOSE_ADJUSTMENTS=false
# DEFAULT_INJURY_ADJUSTMENTS=false
# DEFAULT_WEATHER_ADJUSTMENTS=false
# DEFAULT_UPSETS_AGENT=true

# Prediction defaults
# WEEK_NUMBER=1
# YEAR_ABBR=25

# AWS configuration
# INPUT_BUCKET=nfl-score-predictor-test-input
# OUTPUT_BUCKET=nfl-score-predictor-test-output

# File names (if you want to override the defaults)
# INPUT_FILE_NAME=upcoming_matchups.csv
# INJURIES_FILE_NAME=nfl_injuries_test.csv
# PROPERTIES_FILE_NAME=nfl_properties_test.yaml
# OUTPUT_FILE_NAME=predicted_matchups_test.csv
# FLAGGED_OUTPUT_FILE_NAME=predicted_matchups_flagged_test.csv
