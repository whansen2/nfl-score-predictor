# NFL Score Predictor Optional Environment Variables

# The core predictor runs with defaults from nfl_predictor/utils/constants.py.
# Uncomment overrides here only if you want to change local behavior.

# Logging
# LOG_LEVEL=INFO

# Feature flags (true/false)
# VERBOSE_ADJUSTMENTS=false
# ENABLE_INJURY_ADJUSTMENTS=false

# Prediction defaults
# YEAR_ABBR=26

# Lambda output configuration
# OUTPUT_BUCKET=nfl-score-predictor-test-output

# Matchup week is read from nfl_predictor/data/upcoming_matchups_auto.csv
